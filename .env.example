# Copy to .env. Generate a private token with: openssl rand -hex 32
# The placeholder deliberately fails validation until replaced.
ATLAS_WRITE_TOKEN=replace-with-a-random-token
ATLAS_DATA_DIR=.local
ATLAS_PORT=4317
ATLAS_FRONTEND_PORT=5173
# Browser tests always create and remove their own temporary storage.
ATLAS_E2E_PORT=4174
