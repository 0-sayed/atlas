{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "showcase": "npm run build && node dist-server/scripts/showcase.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.server.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=.env dist-server/server/main.js",
    "seed": "node --env-file-if-exists=.env dist-server/scripts/seed.js",
    "dev:api": "tsx --tsconfig tsconfig.server.json --env-file-if-exists=.env server/main.ts",
    "storage": "node --env-file-if-exists=.env dist-server/server/cli.js",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run build && npm run check:artifacts && npm run smoke",
    "check:artifacts": "node dist-server/scripts/check-artifacts.js",
    "smoke": "node dist-server/scripts/smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "react-zoom-pan-pinch": "4.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
